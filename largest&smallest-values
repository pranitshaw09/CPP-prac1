#include <iostream>
using namespace std;

int main() {
    int ages[5] = {12, 15, 19, 14, 18};
    int minAge = ages[0]; 
    for (int i = 1; i < 5; i++) {
    
        if (ages[i] < minAge) { 
            minAge = ages[i];
        }
    }

    cout << "The youngest age is: " << minAge << endl;

    return 0;
}
